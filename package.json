  },
  "overrides": {
    "near-sandbox": {
      "tar": "7.5.22"
    }
  },
  "devDependencies": {
    "near-api-js": "7.4.0",
    "near-sandbox": "0.3.5"
  },
  "dependencies": {
    "@near-intents-agent-api/sdk": "0.8.0"
  }
}
