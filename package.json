{
  "name": "u01-local-qualification",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "build:probe": "CARGO_TARGET_DIR=$PWD/target cargo near build non-reproducible-wasm --locked --manifest-path qualification/contract/Cargo.toml --no-abi --out-dir target/qualification",
    "test:sandbox": "node --test --test-timeout=120000 qualification/sandbox.test.mjs"
  },
  "overrides": {
    "near-sandbox": {
      "tar": "7.5.22"
    },
    "@meteorwallet/sdk": {
      "nanoid": "5.1.16"
    },
    "decode-uri-component": "0.5.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "near-api-js": "7.4.0",
    "near-sandbox": "0.3.5"
  },
  "dependencies": {
    "@meteorwallet/sdk": "3.24.1",
    "@near-intents-agent-api/sdk": "0.8.0",
    "borsh": "2.0.0",
    "buffer": "6.0.3",
    "process": "0.11.10",
    "util": "0.12.5"
  }
}
